# Copy this file to .env and edit the URLs for your deployment.
# These origins are compiled into public/oauth-client-metadata.json, including the
# OAuth redirect URI. They must match the URL the browser actually uses.

# Public origin of the dev server. For local dev, expose VITE_PORT through a
# tunnel (for example Cloudflare Tunnel) and set this to the public HTTPS URL.
VITE_DEV_URL=https://dev.reddwarf.app

# Public origin of the production build.
VITE_PROD_URL=https://reddwarf.app

# Local port the dev and preview servers listen on.
VITE_PORT=3769

# PDS handle resolver used by production builds. Defaults to
# https://selfhosted.social when unset.
# VITE_PROD_HANDLE_RESOLVER=https://selfhosted.social

# PDS handle resolver used by dev. Defaults to https://bsky.social when unset.
# VITE_DEV_HANDLE_RESOLVER=https://bsky.social
